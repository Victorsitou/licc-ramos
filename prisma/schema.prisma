generator client {
  provider     = "prisma-client-js"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String                 @id @default(cuid())
  email               String                 @unique
  passwordHash        String
  createdAt           DateTime               @default(now())
  name                String
  role                UserRole               @default(STUDENT)
  verified            Boolean                @default(false)
  UserProblemProgress UserProblemProgress[]
  progressRecords     UserResourceProgress[]
  courses             String[]               @default([])
  refreshTokens      RefreshToken[]

  @@map("users")
}

model Resource {
  id              String                 @id @default(cuid())
  title           String
  url             String
  type            ResourceType
  slug            String?
  orderIndex      Int?
  createdAt       DateTime               @default(now())
  key             String                 @default("")
  progressRecords UserResourceProgress[]

  @@index([type, orderIndex])
  @@map("resources")
}

model UserResourceProgress {
  userId      String
  resourceId  String
  completedAt DateTime @default(now())
  resource    Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, resourceId])
  @@index([resourceId])
  @@map("user_resource_progress")
}

model VerificationToken {
  id        String   @id @default(cuid())
  email     String
  tokenHash String   @unique
  expiresAt DateTime

  @@index([email])
  @@map("verification_tokens")
}

model Problem {
  id                  String                @id
  title               String
  description         String?
  orderIndex          Int
  createdAt           DateTime              @default(now())
  collectionId        String
  ProblemCollection   ProblemCollection     @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  UserProblemProgress UserProblemProgress[]

  @@unique([collectionId, orderIndex])
  @@index([collectionId, orderIndex])
}

model RefreshToken {
  id            String   @id @default(cuid())
  tokenHash     String   @unique
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
  lastUsedAt    DateTime?
  expiresAt     DateTime
  replacedById  String?  @unique
  revoked       Boolean  @default(false)

  @@index([tokenHash])
}

model ProblemCollection {
  id          String                @id
  title       String
  description String?
  orderIndex  Int
  type        ProblemCollectionType
  createdAt   DateTime              @default(now())
  Problem     Problem[]

  @@unique([type, orderIndex])
}

model UserProblemProgress {
  userId      String
  problemId   String
  completedAt DateTime @default(now())
  Problem     Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)
  users       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, problemId])
  @@index([problemId])
}

enum ResourceType {
  CLASS
  WORKSHOP
  AYUDANTIA
  EXTRA
}

enum UserRole {
  STUDENT
  ADMIN
}

enum ProblemCollectionType {
  SET
  ACTIVIDAD
  INTERROGACION
  COMPILADO
}
